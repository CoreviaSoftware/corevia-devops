# Copy this to .env on the server. NEVER commit the real .env file.
# Generate strong secrets with:  openssl rand -base64 48
#
# IMPORTANT: SPRING_PROFILE=prod (set below) is what activates
# application-prod.yml. Without it the app boots under the 'local' profile
# with dev sentinels and localhost URLs — login will not work.

# --- Domain & TLS -----------------------------------------------------------
DOMAIN=corevia.example.com
ACME_EMAIL=you@example.com

# --- Database ---------------------------------------------------------------
# DB_USERNAME / DB_PASSWORD = Postgres owner. Used ONLY by Flyway to run
# migrations (which need DDL + role-management privileges).
DB_NAME=smartcity
DB_USERNAME=smartcity
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DB_APP_USERNAME / DB_APP_PASSWORD = least-privilege role used by the running
# application for all CRUD. Created by migration V5__app_role.sql. If a SQL
# injection ever lands, this role cannot DROP / ALTER tables.
DB_APP_USERNAME=smartcity_app
DB_APP_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD

# --- App secrets ------------------------------------------------------------
# Generate each with:  openssl rand -base64 48   (or -base64 32 for APP_SECRET_KEY)
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_OF_ENTROPY_BASE64
# AES-256 master key (must decode to exactly 32 bytes). Encrypts device secrets
# at rest. Generate with: openssl rand -base64 32
APP_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
SPRING_PROFILE=prod

# --- First admin bootstrap --------------------------------------------------
# On first prod boot, if the users table is empty, a SUPER_ADMIN with this
# email is created with a random password printed to the log once. After the
# first admin exists, this var is ignored. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=you@corevia.example.com

# --- Mail (transactional) ---------------------------------------------------
# Use a real provider (Resend, Postmark, SES, SendGrid). Personal Gmail is not
# suitable for prod — rate limits and deliverability.
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@corevia.example.com

# --- MediaMTX ---------------------------------------------------------------
# HLS URL handed back to browsers. Must be HTTPS in prod (browsers block mixed
# content). Routed through Caddy to mediamtx:8888.
MEDIAMTX_HLS_URL_PUBLIC=https://hls.corevia.example.com
MEDIAMTX_API_USERNAME=smartcity
MEDIAMTX_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MEDIAMTX_SHARED_SECRET=CHANGE_ME_STRONG_SECRET
# HMAC key the BE uses to sign per-stream HLS URL tokens. BE-only secret.
MEDIAMTX_SIGNING_KEY=CHANGE_ME_STRONG_SECRET

# --- Public URLs (used in CORS + email links) ------------------------------
CORS_ALLOWED_ORIGINS=https://corevia.example.com
MFA_VERIFY_URL=https://corevia.example.com/ro/mfa
PASSWORD_RESET_URL=https://corevia.example.com/ro/reset-password
ACCOUNT_INVITE_URL=https://corevia.example.com/ro/create-account
MEDIA_PUBLIC_BASE_URL=https://corevia.example.com

# --- Image tags (optional) --------------------------------------------------
# Pin to a specific commit by setting these. Defaults to :latest.
# IMAGE_TAG_BE=sha-abc1234
# IMAGE_TAG_FE=sha-abc1234
