# Copy this to .env on the server. NEVER commit the real .env file.
# Generate strong secrets with:  openssl rand -base64 48
#
# IMPORTANT: SPRING_PROFILE=prod (set below) is what activates
# application-prod.yml. Without it the app boots under the 'local' profile
# with dev sentinels and localhost URLs -- login will not work.
#
# This file only lists values the running stack reads. Infra URLs, the public
# domain in CORS / MFA / reset / invite / media links, the SMTP host/user, the
# MediaMTX API URL, the bootstrap-admin email, etc. are hardcoded in
# smartcity-be/src/main/resources/application-prod.yml. To change any of
# those you edit the YAML and rebuild the BE image -- they are not env-driven.

# --- Domain & TLS (Caddy) ---------------------------------------------------
DOMAIN=staging.corevia.ro
ACME_EMAIL=you@corevia.ro

# --- Database ---------------------------------------------------------------
# DB_PASSWORD = Postgres owner password. Used by Flyway (which needs DDL +
# role-management privileges) and to initialize the postgres container.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DB_APP_PASSWORD = least-privilege role used by the running app for all CRUD.
# The role itself (smartcity_app) is created by Flyway V5__app_role.sql. If
# a SQL injection ever lands, this role cannot DROP / ALTER tables.
DB_APP_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD

# --- App secrets ------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_OF_ENTROPY_BASE64
# AES-256 master key (must decode to exactly 32 bytes). Encrypts device
# secrets at rest. Generate with:  openssl rand -base64 32
APP_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
SPRING_PROFILE=prod

# --- Mail (SMTP password only) ----------------------------------------------
# Host / port / username / from-address are hardcoded in application-prod.yml
# (mail.corevia.ro:587, noreply@corevia.ro). Only the password is env-driven.
MAIL_PASSWORD=CHANGE_ME

# --- MediaMTX ---------------------------------------------------------------
# api-username (smartcity), api-url, hls-base-url are hardcoded in
# application-prod.yml. Only the three secrets below come from env.
MEDIAMTX_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MEDIAMTX_SHARED_SECRET=CHANGE_ME_STRONG_SECRET
# HMAC key the BE uses to sign per-stream HLS URL tokens. BE-only secret.
MEDIAMTX_SIGNING_KEY=CHANGE_ME_STRONG_SECRET

# --- Admin seeding (optional) -----------------------------------------------
# Create-only multi-admin seeder. ProdAdminSeeder inserts rows only if
# missing; existing users are never overwritten in prod. Safe to leave set.
# Format:  email1:password1,email2:password2
# DEV_ADMIN_ACCOUNTS=first@corevia.ro:ChangeMe1!,second@corevia.ro:ChangeMe2!

# --- Image tags (optional) --------------------------------------------------
# Pin to a specific commit. Defaults to :latest.
# IMAGE_TAG_BE=sha-abc1234
# IMAGE_TAG_FE=sha-abc1234
