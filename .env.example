DB_NAME=smartcity
DB_USERNAME=smartcity
DB_PASSWORD=smartcity
DB_PORT_HOST=5433

JWT_SECRET=change-me-in-production-must-be-at-least-256-bits-long-for-hs256

SPRING_PROFILE=dev

# MediaMTX dev defaults. Required by the backend; compose no longer hard-codes
# fallbacks so prod cannot accidentally pick up the dev secret.
MEDIAMTX_SHARED_SECRET=smartcity-dev-mediamtx-shared-secret
MEDIAMTX_API_USERNAME=smartcity
MEDIAMTX_API_PASSWORD=smartcity-dev-mediamtx-api-password

# MediaMTX auth callback. Defaults assume backend runs on the host (IntelliJ);
# set to http://backend:3001/internal/mediamtx/auth when running BE in compose.
# MEDIAMTX_AUTH_URL=http://host.docker.internal:3001/internal/mediamtx/auth

# HLS URL returned to the browser. Default localhost:8888 works for local dev;
# override to the public MediaMTX hostname in staging/prod.
# MEDIAMTX_HLS_URL_PUBLIC=http://localhost:8888

# TLS deployments only: the origin that gives the embedded Signworld portal its
# own browser origin. Must reach the same frontend container through a reverse
# proxy site block. Reusing the app's hostname on a second port avoids a new DNS
# record and reuses the existing certificate:
#   SIGNWORLD_PROXY_ORIGIN=https://staging.corevia.ro:3031
# Next inlines NEXT_PUBLIC_* into the bundle at build time, so this only takes
# effect on a frontend image built with docker-compose.local.yml — a GHCR image
# needs the same value passed as a build arg in its own CI.
# Leave empty on IP-only boxes: there port 3031 is the origin (see the Windows
# overlay), and the frontend derives it from the request.
# SIGNWORLD_PROXY_ORIGIN=
