# Per-box config. Copy to .env on each Windows box and edit.
# NEVER commit the real .env. Generate strong secrets with (Git Bash):
#   openssl rand -base64 48
#
# IMPORTANT: replace 192.168.1.50 below with THIS box's real IP (or hostname).
# The two boxes are independent — each gets its own .env with its own IP.
#
# The app is served at http://<this-box-ip>:3030
# The isolated Signworld proxy is served at http://<this-box-ip>:3031
# HLS video is served at http://<this-box-ip>:8888

# --- Public URLs (per box — must match this box's IP) -----------------------
# CORS origin the backend accepts and the base for MFA / reset / invite email
# links and media URLs. All point at this box's frontend (:3030) except HLS.
CORS_ALLOWED_ORIGINS=http://192.168.1.50:3030
MFA_VERIFY_URL=http://192.168.1.50:3030/ro/mfa
PASSWORD_RESET_URL=http://192.168.1.50:3030/ro/reset-password
ACCOUNT_INVITE_URL=http://192.168.1.50:3030/ro/create-account
MEDIA_PUBLIC_BASE_URL=http://192.168.1.50:3030
MEDIAMTX_HLS_URL_PUBLIC=http://192.168.1.50:8888

# --- Spring profile ---------------------------------------------------------
# prod activates application-prod.yml + ProdConfigGuard. Do not change.
SPRING_PROFILE=prod

# --- Database ---------------------------------------------------------------
# DB_PASSWORD      = Postgres owner (Flyway: DDL + role management).
# DB_APP_PASSWORD  = least-privilege role the running app uses for CRUD.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_APP_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD

# --- App secrets ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_AT_LEAST_256_BITS_OF_ENTROPY_BASE64
# AES-256 master key — must decode to exactly 32 bytes:  openssl rand -base64 32
APP_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Mail (SMTP password only) ----------------------------------------------
# Host/port/user/from are hardcoded in application-prod.yml (mail.corevia.ro:587,
# noreply@corevia.ro). This box must have outbound access to that SMTP server,
# or MFA and password-reset emails (and therefore login) will not work.
MAIL_PASSWORD=CHANGE_ME

# --- MediaMTX ---------------------------------------------------------------
MEDIAMTX_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MEDIAMTX_SHARED_SECRET=CHANGE_ME_STRONG_SECRET
# HMAC key the backend uses to sign per-stream HLS URL tokens. BE-only secret.
MEDIAMTX_SIGNING_KEY=CHANGE_ME_STRONG_SECRET

# --- Admin seeding (optional) -----------------------------------------------
# Create-only in prod: inserted if missing, never overwritten. Safe to leave set.
# Format:  email1:password1,email2:password2
# DEV_ADMIN_ACCOUNTS=admin@corevia.ro:ChangeMe1!

# --- Image tags (optional) --------------------------------------------------
# Pin to a specific build for rollback / freeze. Defaults to :latest.
# IMAGE_TAG_BE=sha-abc1234
# IMAGE_TAG_FE=sha-abc1234
